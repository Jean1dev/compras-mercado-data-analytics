# LiteLLM proxy (OpenAI-compat)
LITELLM_BASE_URL=https://lite-llm-deploy-production.up.railway.app/v1
LITELLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4-6

# String de conexao do MongoDB
MONGODB_URI=mongodb://localhost:27017/compras-mercado

# DSN do Sentry (opcional). Se nao definido, usa o DSN padrao do projeto.
SENTRY_DSN=
